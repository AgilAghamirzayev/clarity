#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$ROOT"
scripts/mvn package -DskipTests -q
if [ -x /usr/libexec/java_home ]; then JAVA_HOME=$(/usr/libexec/java_home -v 21); export JAVA_HOME; fi
exec python3 scripts/run.py "${JAVA_HOME:+$JAVA_HOME/bin/}java" -jar server/target/csi-api-1.0.0.jar
