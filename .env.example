# Generate private values with python3 scripts/setup-local.py.
DB_OWNER_PASSWORD=replace-with-generated-value
DB_APP_PASSWORD=replace-with-generated-value
S3_ACCESS_KEY=csi-local
S3_SECRET_KEY=replace-with-generated-value
S3_ENDPOINT=http://localhost:9100
S3_BUCKET=csi-audio
TEMPORAL_DB_PASSWORD=replace-with-generated-value
TEMPORAL_ADDRESS=localhost:17233
BOOTSTRAP_TENANT=local
BOOTSTRAP_EMAIL=admin@csi.local
BOOTSTRAP_PASSWORD=replace-with-at-least-16-random-characters
# false only for localhost HTTP. Use true behind production HTTPS.
COOKIE_SECURE=false
VITE_DATA_MODE=api
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b-instruct
EMBEDDING_MODEL=nomic-embed-text:latest
WHISPER_MODEL=/absolute/path/to/CSI/.models/whisper-small
SPEAKER_MODEL=/absolute/path/to/CSI/.models/ecapa
# Optional: set PII_BACKEND=gliner after provisioning --include-gliner.
PII_BACKEND=ollama
GLINER_MODEL=/absolute/path/to/CSI/.models/gliner
# Explicit destinations only. Integrations are disabled until an administrator enables them.
INTEGRATION_ALLOWED_ORIGINS=
# Each configured integration returns its CSI_INTEGRATION_<uuid_with_underscores>_TOKEN variable.
